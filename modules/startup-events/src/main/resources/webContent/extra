<root available-locales="en_US" default-locale="en_US">
    <dynamic-element name="cardTitle" field-reference="cardTitle" type="text">
        <dynamic-content language-id="en_US"><![CDATA[%TITLE%]]></dynamic-content>
    </dynamic-element>

    <dynamic-element name="cardDescription" field-reference="cardDescription" type="rich_text">
        <dynamic-content language-id="en_US"><![CDATA[%DESCRIPTION%]]></dynamic-content>
    </dynamic-element>

    <dynamic-element name="cardImage" field-reference="cardImage" type="image">
        <dynamic-content language-id="en_US"><![CDATA[%IMAGE_JSON%]]></dynamic-content>
    </dynamic-element>
</root>